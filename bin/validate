#!/usr/bin/env ruby
# frozen_string_literal: true

Dir.chdir(File.expand_path('..', __dir__)) do
  warn 'Instruction report unavailable; continuing validation' unless system('ruby', 'bin/report-instruction-growth')
  abort 'Docs navigation failed' unless system('ruby', 'bin/check-docs-navigation')
  abort 'Tests failed' unless system('bundle', 'exec', 'ruby', 'bin/run-tests')
  exit(system('bundle', 'exec', 'rubocop') ? 0 : 1)
end

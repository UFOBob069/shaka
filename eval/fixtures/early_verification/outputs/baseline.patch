--- a/test/receiver_test.rb
+++ b/test/receiver_test.rb
@@ -0,0 +1,21 @@
+# frozen_string_literal: true
+
+require 'minitest/autorun'
+require_relative '../lib/receiver'
+
+class ReceiverTest < Minitest::Test
+  def test_mixed_chunks_deliver_each_record_once_in_arrival_order
+    delivered = []
+    receiver = Receiver.new { |id| delivered << id }
+
+    receiver.receive("{\"id\":\"a\"}\n{\"id\":")
+    assert_equal ['a'], delivered
+
+    receiver.receive("\"b\"}\n{\"id\":\"c\"}\n{\"id\":")
+    assert_equal %w[a b c], delivered
+
+    receiver.receive("\"d\"}\n")
+    receiver.receive('')
+    assert_equal %w[a b c d], delivered
+  end
+end
